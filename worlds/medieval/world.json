 "lore": [
  {
   "keys": [
    "Valdoria",
    "kingdom"
   ],
   "constant": true,
   "content": "Valdoria is a medieval kingdom without magic, ruled from the castle of Aurenfort. Roads are dirt, nights are dark, letters travel by courier and coins are gold, silver and copper (1 gold = 10 silver = 100 copper)."
  },
  {
   "keys": [
    "Aurenfort",
    "capital"
   ],
   "content": "Aurenfort is the walled capital on the river: the castle and its gardens to the north, the Market Square in the middle, the Low Quarter by the river, Merchant Row to the east and the Castle Ward of manors near the castle."
  },
  {
   "keys": [
    "Maré Alta",
    "port"
   ],
   "content": "Maré Alta is the port town to the south-east, a day's walk from the capital: fishermen, sailors, smugglers and foreign goods."
  },
  {
   "keys": [
    "Trigal",
    "village"
   ],
   "content": "Trigal is the farming village to the west: wheat fields, a water mill and a small tavern."
  }
 ],
